{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aeriel-aiff",
  "assets": {
    "directory": "."
  },
  "compatibility_date": "2026-01-01",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
